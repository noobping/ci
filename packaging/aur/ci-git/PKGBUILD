# Maintainer: Nick <hello@noobping.dev>
pkgname=ci-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Small Git-native CI runner and build tool'
arch=('x86_64' 'aarch64')
url='https://github.com/noobping/ci'
license=('MIT')
depends=('gcc-libs' 'git')
makedepends=('cargo' 'git')
optdepends=(
  'podman: run containerized workflows and containerized Git fallback'
  'docker: run containerized workflows and containerized Git fallback'
)
provides=('ci')
conflicts=('ci' 'rcs')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/${pkgname%-*}"

  local version rev_count rev_hash
  version="$(awk -F\" '/^version =/ { print $2; exit }' Cargo.toml)"
  rev_count="$(git rev-list --count HEAD)"
  rev_hash="$(git rev-parse --short HEAD)"
  printf '%s.r%s.g%s' "$version" "$rev_count" "$rev_hash"
}

prepare() {
  cd "$srcdir/${pkgname%-*}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$srcdir/${pkgname%-*}"
  cargo build --frozen --release
}

check() {
  cd "$srcdir/${pkgname%-*}"
  cargo test --frozen --release --all
}

package() {
  cd "$srcdir/${pkgname%-*}"

  install -Dm0755 "target/release/${pkgname%-*}" "$pkgdir/usr/bin/${pkgname%-*}"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  "target/release/${pkgname%-*}" completion bash \
    --output "$pkgdir/usr/share/bash-completion/completions/${pkgname%-*}"
  "target/release/${pkgname%-*}" man --dir "$pkgdir/usr/share/man/man1"
}
